# App do Instagram (Casos de uso > Personalizar > Configuracao da API com
# login do Instagram). NAO e o par de Configuracoes do app > Basico (esse e
# do Facebook e nao funciona aqui).
IG_APP_ID=
IG_APP_SECRET=

# String secreta que voce inventa. A MESMA vai no portal do Meta.
VERIFY_TOKEN=

# Token gerado na mesma pagina (Configuracao da API com login do Instagram).
# Curto (~1h): o /api/connect troca por 60 dias.
ACCESS_TOKEN=

# Connection string do Neon (neon.tech)
DATABASE_URL=

# Senha para entrar no painel
PANEL_PASSWORD=

# Opcional, e recomendado: tranca as tarefas agendadas (renovacao do token e
# recalculo). Definiu, so roda com o segredo; nao definiu, roda como sempre.
# A Vercel envia como Bearer automaticamente. Gere um segredo forte.
CRON_SECRET=

# Opcional. Origens extras que o servidor MCP aceita, separadas por virgula.
# Por padrao ja valem o seu proprio endereco e as do Claude. Preencha se for
# ligar outro cliente e ele responder "Origem nao permitida".
MCP_ORIGENS_PERMITIDAS=

# --- Só para o simulador de teste (opcional) ---
# URL do webhook publicado. Em local: http://localhost:3000/api/webhook
WEBHOOK_URL=
# Seu ig_user_id, mostrado na tela de Configuração depois de conectar
IG_USER_ID=

# E-mail que aparece na sua politica de privacidade, para quem quiser
# pedir a remocao dos proprios dados.
EMAIL_CONTATO=
