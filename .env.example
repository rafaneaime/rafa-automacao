# App do Instagram (Casos de uso > Personalizar > Configuracao da API com
# login do Instagram). NAO e o par de Configuracoes do app > Basico (esse e
# do Facebook e nao funciona aqui).
IG_APP_ID=
IG_APP_SECRET=

# String secreta que voce inventa. A MESMA vai no portal do Meta.
VERIFY_TOKEN=

# Token gerado na mesma pagina (Configuracao da API com login do Instagram).
# Curto (~1h): o /api/connect troca por 60 dias.
ACCESS_TOKEN=

# Connection string do Neon (neon.tech)
DATABASE_URL=

# Senha para entrar no painel
PANEL_PASSWORD=

# Opcional: protege a rota de cron. A Vercel envia como Bearer automaticamente.
CRON_SECRET=

# --- Só para o simulador de teste (opcional) ---
# URL do webhook publicado. Em local: http://localhost:3000/api/webhook
WEBHOOK_URL=
# Seu ig_user_id, mostrado na tela de Configuração depois de conectar
IG_USER_ID=

